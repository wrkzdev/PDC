# Public-node gateway in front of pdcd's unauthenticated RPC. Rendered by docker-entrypoint.sh (envsubst).
load_module modules/ngx_http_js_module.so;

worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events { worker_connections 2048; }

http {
  js_import gate from /etc/nginx/pdc/gateway.js;

  default_type application/octet-stream;
  server_tokens off;
  # Clients' IPs are not logged: this node is meant to be used by wallets, which leak enough as it is.
  access_log off;

  client_body_temp_path /tmp/client_temp;
  proxy_temp_path       /tmp/proxy_temp;

  limit_req_zone  $binary_remote_addr zone=light:10m rate=${RATE_LIGHT}r/s;
  limit_req_zone  $binary_remote_addr zone=heavy:10m rate=${RATE_HEAVY}r/s;
  limit_conn_zone $binary_remote_addr zone=perip:10m;

  upstream pdcd {
    server ${PDCD_UPSTREAM};
    keepalive 16;
  }

  gzip on;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_types application/json application/octet-stream;

  server {
    listen 8080;
    server_name _;

    # Behind the TLS proxy every request arrives from the proxy's address; take the real client address from
    # X-Forwarded-For, but only when it comes from a private (docker) network, so it can't be spoofed from outside.
    # It is used for rate limiting only and is never passed on to pdcd (see proxy_set_header below).
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    client_max_body_size 1m;
    client_body_buffer_size 1m;   # keep bodies in memory so njs can read them
    limit_conn perip 20;
    limit_req_status 429;
    limit_conn_status 429;

    # CORS: requests carry no cookies or bearer tokens, so a wildcard origin is safe; restrict with CORS_ALLOW_ORIGIN.
    add_header Access-Control-Allow-Origin  "${CORS_ALLOW_ORIGIN}" always;
    add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type" always;
    add_header Access-Control-Max-Age       86400 always;
    add_header X-Content-Type-Options       nosniff always;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Accept-Encoding "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Real-IP "";
    proxy_read_timeout 120s;
    proxy_send_timeout 30s;

    if ($request_method !~ ^(GET|POST|OPTIONS)$) { return 405; }

    location = /healthz {
      default_type text/plain;
      return 200 "ok\n";
    }

    # small JSON calls
    location ~ ^/(getheight|getinfo|gettransactions|sendrawtransaction)$ {
      if ($request_method = OPTIONS) { return 204; }
      limit_req zone=light burst=40 nodelay;
      proxy_pass http://pdcd;
    }

    # binary (epee portable storage) calls; getblocks.bin is the expensive one
    location ~ ^/(getblocks|get_o_indexes|getrandom_outs3|get_tx_pool|check_keyimages)\.bin$ {
      if ($request_method = OPTIONS) { return 204; }
      limit_req zone=heavy burst=20 nodelay;
      proxy_pass http://pdcd;
    }

    # JSON-RPC: method allowlist in gateway.js
    location = /json_rpc {
      if ($request_method = OPTIONS) { return 204; }
      limit_req zone=light burst=40 nodelay;
      js_content gate.jsonrpc;
    }
    location = /_pdcd_jsonrpc {
      internal;
      proxy_pass http://pdcd/json_rpc;
    }

    # everything else (start_mining, stop_mining, force_relay, set_maintainers_info.bin, ...) is refused
    location / {
      default_type application/json;
      return 403 '{"error":"Not available on this public node"}\n';
    }
  }
}
